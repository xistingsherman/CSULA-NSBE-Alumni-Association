# Copy this file to .env and fill it in (locally, and in the app folder on MochaHost).
# .env holds passwords: it's in .gitignore, so it never gets committed.

NODE_ENV=development
PORT=5173

# Public address of the site (used in email links)
SITE_URL=http://localhost:5173

# "mysql" for the real database, "memory" to try the site locally with sample data
DB_CLIENT=memory

# MySQL connection (from cPanel > MySQL Databases). cPanel adds your account name
# as a prefix, e.g. youruser_nsbe for both the database and the user.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Resume storage: name of your private GCP bucket, and the path to the service account key file.
# Leave GCS_BUCKET empty to save resumes in ./uploads instead (local testing only).
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Where new sign-up notifications go
BOARD_EMAIL=alumni@example.org

# Outgoing email (a cPanel email account works: host is usually mail.yourdomain.com, port 465)
# Leave SMTP_HOST empty to print emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cal State LA NSBE Alumni <alumni@example.org>

# Temporary admin login (works locally and on the live site).
# While both are set, you can sign in with them as an admin. Remove both lines and
# restart the app to delete the temporary account and sign it out everywhere.
# Use an email that isn't a member's. On the live site the password must be 16+ characters.
# Choose your own password; never reuse one that's written down in this repo.
TEMP_ADMIN_EMAIL=
TEMP_ADMIN_PASSWORD=
