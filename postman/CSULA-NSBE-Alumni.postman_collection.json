{
  "info": {
    "name": "CSULA NSBE Alumni API",
    "description": "End-to-end tests for the Cal State LA NSBE Alumni Association app.\n\nRun the whole collection in order (Collection > Run). It creates a test member, uploads a resume,\napproves it as an admin, checks privacy settings, and signs out. A second test account is created and rejected.\n\nSetup: pick the \"Local\" or \"Production\" environment and fill in adminEmail / adminPassword\n(the TEMP_ADMIN_* login, or any admin account). Sessions use a cookie, which Postman keeps automatically;\nmake sure Settings > General > \"Automatically follow redirects\" is ON (resume downloads redirect to a signed link).\n\nAgainst Production this leaves 2 test rows in `members` (emails ending @example.com) and 1 in `join_requests`.\nDelete them in phpMyAdmin afterwards. Test emails are random each run, so re-running is safe.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "memberEmail",
      "value": ""
    },
    {
      "key": "memberPassword",
      "value": "postman-test-pass-123"
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "rejectEmail",
      "value": ""
    },
    {
      "key": "rejectId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fresh random test emails for each run, so re-running doesn't hit 'email already exists'.",
          "if (pm.info.iteration === 0 && pm.info.requestName === 'Sign out (start clean)') {",
          "  const n = Date.now();",
          "  pm.collectionVariables.set('memberEmail', `postman.member.${n}@example.com`);",
          "  pm.collectionVariables.set('rejectEmail', `postman.reject.${n}@example.com`);",
          "}"
        ]
      }
    }
  ],
  "item": [
